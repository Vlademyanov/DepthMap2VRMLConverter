{
  "inputFile": "DepthMap_7.dat",
  "outputFile": "output.vrml",
  "exportFormat": "vrml",
  "lightingModel": "phong",
  "enableVisualization": true,

  "camera": {
    "position": [0, 0, 150],
    "target": [32, 32, 0],
    "up": [0, 1, 0],
    "fov": 45,
    "nearPlane": 0.1,
    "farPlane": 10000,
    "projectionType": "perspective"
  },

  "light": {
    "direction": [1, 1, 1],
    "color": [1.0, 1.0, 1.0],
    "intensity": 1.0
  },

  "renderImage": {
    "enabled": true,
    "width": 1024,
    "height": 768,
    "outputFile": "render.bmp"
  },

  "material": {
    "roughness": 0.5,
    "diffuseColor": [0.7, 0.7, 0.9],
    "specularColor": [1.0, 1.0, 1.0],
    "shininess": 32.0
  }
}